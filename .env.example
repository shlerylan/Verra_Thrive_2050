# Local review only. Do not expose this unauthenticated scaffold publicly.
POSTGRES_USER=thrive
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=thrive
DATABASE_URL=postgresql+psycopg://thrive:local-development-only@localhost:5432/thrive
UPLOAD_DIR=./.local/uploads
MAX_UPLOAD_BYTES=20971520
MAX_ARCHIVE_BYTES=104857600
MAX_ARCHIVE_ENTRIES=2000
MAX_COMPRESSION_RATIO=100
API_PROXY_TARGET=http://127.0.0.1:8000
# Native tests only: set to a separate disposable PostgreSQL database.
